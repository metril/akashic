# PostgreSQL
POSTGRES_USER=akashic
POSTGRES_PASSWORD=changeme
POSTGRES_DB=akashic

# Meilisearch
MEILI_MASTER_KEY=changeme-meili-key

# API
# Legacy: only needed once when upgrading an install that used SECRET_KEY (imported into the key file). New installs generate the key file automatically.
# SECRET_KEY=
DATABASE_URL=postgresql+asyncpg://akashic:changeme@postgres:5432/akashic
MEILI_URL=http://meilisearch:7700
MEILI_KEY=changeme-meili-key
REDIS_URL=redis://redis:6379/0

# Scanner
AKASHIC_API_URL=http://api:8000
AKASHIC_API_KEY=scanner-api-key
# If you front the API with your own reverse proxy, raise its
# request-body limit — the scanner POSTs multi-MB ingest batches
# (nginx: `client_max_body_size 32m;`; the default 1 MB is too small).
